    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrFlyingPig/dsh-plugin-restart.git"
  },
  "bugs": {
    "url": "https://github.com/DrFlyingPig/dsh-plugin-restart/issues"
  },
  "homepage": "https://github.com/DrFlyingPig/dsh-plugin-restart#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
